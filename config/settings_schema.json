  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "60rem",
            "label": "t:options.page_width.slim"
          },
          {
            "value": "70rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "90rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "60rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 16,
        "max": 120,
        "step": 4,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 64
