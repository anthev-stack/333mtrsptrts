  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "60rem",
            "label": "t:options.page_width.slim"
          },
          {
            "value": "70rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "90rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "60rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 16,
        "max": 120,
        "step": 4,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 64
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFFFF",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#111111",
        "label": "t:labels.foreground"
      },
      {
        "type": "color",
        "id": "accent_color",
        "default": "#F5C518",
        "label": "Accent",
        "info": "Used for vehicle search, PL8SRCH, and other highlights."
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 0
      }
    ]
  },
  {
    "name": "Partbot",
    "settings": [
      {
        "type": "checkbox",
        "id": "partbot_demo_mode",
        "label": "Demo preview mode",
        "default": true,
        "info": "Shows a non-functional vehicle search and PL8SRCH preview so you can judge layout. Disables live Partbot while enabled."
      },
      {
        "type": "checkbox",
        "id": "partbot_enable",
        "label": "Enable Partbot",
        "default": false,
        "info": "Turns on live vehicle search and product Partbot integrations. Ignored while Demo preview mode is on. Requires the Partbot app and API key."
      },
      {
        "type": "text",
        "id": "partbot_api_key",
        "label": "Partbot API key",
        "info": "Find your public API key in Partbot account settings. Only works on approved domains."
      },
      {
        "type": "url",
        "id": "partbot_callback_url",
        "label": "Search redirect URL",
        "info": "Collection customers land on after searching from non-collection pages. Usually your All products collection."
      },
      {
        "type": "text",
        "id": "partbot_field_prefix",
        "label": "Field prefix",
        "info": "Must match the Field Prefix in Partbot admin if set (e.g. pb_). Leave blank if unused."
      },
      {
        "type": "text",
        "id": "partbot_fields",
        "label": "Extra fields",
        "default": "body,series",
        "info": "Comma-separated extras beyond Make/Model/Year. Options: body, series, variant, engine, engine_capacity"
      },
      {
        "type": "text",
        "id": "partbot_button_label",
        "label": "Search button label",
        "default": "Search"
      },
      {
        "type": "checkbox",
        "id": "partbot_show_labels",
        "label": "Show field labels",
        "default": false
      },
      {
        "type": "header",
        "content": "Product page features"
      },
      {
        "type": "checkbox",
        "id": "partbot_show_fitment",
        "label": "Show vehicle fitment check",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "partbot_show_applications",
        "label": "Show vehicle applications table",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "partbot_show_attributes",
        "label": "Show product attributes",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "partbot_show_documents",
        "label": "Show product documents",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "partbot_show_brand_logo",
        "label": "Show brand logo",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "partbot_show_catalogue_notes",
        "label": "Show catalogue notes",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "partbot_show_cross_sell",
        "label": "Show cross-sell products",
        "default": true
      }
    ]
  },
