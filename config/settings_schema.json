  {
    "name": "t:general.logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "t:labels.logo"
      },
      {
        "type": "range",
        "id": "logo_scale",
        "min": 20,
        "max": 100,
        "step": 5,
        "unit": "%",
        "label": "Logo scale",
        "default": 100,
        "info": "Scale the logo from 20% to 100% of its full header size."
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "t:labels.favicon",
        "info": "t:labels.favicon_info"
      }
    ]
  },
