{% doc %}
  Renders product price with compare-at sale and/or member deal pricing.

  @param {product} product - Product to price
  @param {variant} [variant] - Variant to use (defaults to selected or first available)
  @param {string} [class] - Optional extra class on the price wrapper
  @param {boolean} [enable_variant_update] - Adds hooks so JS can refresh price on variant change
{% enddoc %}

{% liquid
  assign price_variant = variant | default: product.selected_or_first_available_variant
  assign price_class = class | default: 'product-price'

  assign membership_tag = settings.membership_tag | default: 'MEMBERSHIP' | strip | downcase
  assign is_member = false
  if customer and membership_tag != blank
    for tag in customer.tags
      assign tag_down = tag | strip | downcase
      if tag_down == membership_tag
        assign is_member = true
        break
      endif
    endfor
  endif

  assign in_member_deals = false
  assign member_deals = settings.member_deals_collection
  if is_member and member_deals != blank
    for collection in product.collections
      if collection.id == member_deals.id
        assign in_member_deals = true
        break
      endif
    endfor
  endif

  assign member_percent = settings.member_discount_percent | default: 0 | plus: 0
  assign show_member_price = false
  assign member_price = price_variant.price
  if in_member_deals and member_percent > 0
    assign show_member_price = true
    assign member_keep = 100 | minus: member_percent
    assign member_price = price_variant.price | times: member_keep | divided_by: 100
  endif

  assign on_sale = false
  if show_member_price == false and price_variant.compare_at_price > price_variant.price
    assign on_sale = true
  endif
%}

<p
  class="{{ price_class }}{% if show_member_price or on_sale %} product-price--on-sale{% endif %}"
  {% if enable_variant_update %}
    data-product-price
    data-money-currency="{{ shop.currency }}"
    data-member-deal="{% if in_member_deals %}true{% else %}false{% endif %}"
    data-member-discount-percent="{{ member_percent }}"
  {% endif %}
>
  {% if show_member_price %}
    <span class="product-price__compare" data-product-price-compare>{{ price_variant.price | money }}</span>
    <span class="product-price__current" data-product-price-current>{{ member_price | money }}</span>
  {% elsif on_sale %}
    <span class="product-price__compare" data-product-price-compare>{{ price_variant.compare_at_price | money }}</span>
    <span class="product-price__current" data-product-price-current>{{ price_variant.price | money }}</span>
  {% else %}
    <span class="product-price__current" data-product-price-current>{{ price_variant.price | money }}</span>
  {% endif %}
</p>

{% stylesheet %}
  .product-price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.45rem 0.65rem;
    margin: 0;
  }

  .product-price__compare {
    color: #888;
    text-decoration: line-through;
    text-decoration-thickness: 1px;
  }

  .product-price__current {
    color: inherit;
    font-weight: 600;
  }

  .product-price--on-sale .product-price__current {
    color: #111;
  }
{% endstylesheet %}
