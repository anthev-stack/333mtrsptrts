{% doc %}
  Renders a product card for collection grids.

  @param {product} product - Product to render
{% enddoc %}

{% liquid
  assign variant = product.selected_or_first_available_variant
  assign color_option = nil

  for option in product.options_with_values
    assign option_name = option.name | downcase
    if option_name == 'color' or option_name == 'colour'
      assign color_option = option
      break
    endif
  endfor

  assign swatch_value = color_option.values.first
  assign image_alt = product.featured_image.alt | default: product.title
%}

<article class="product-card">
  {% if variant.inventory_management != blank and variant.inventory_quantity > 0 %}
    <p class="product-card__stock">{{ 'products.in_stock' | t: count: variant.inventory_quantity }}</p>
  {% elsif product.available %}
    <p class="product-card__stock">{{ 'products.available' | t }}</p>
  {% else %}
    <p class="product-card__stock product-card__stock--sold-out">{{ 'products.sold_out' | t }}</p>
  {% endif %}

  <div class="product-card__media">
    <a href="{{ product.url }}" class="product-card__image-link">
      {% if product.featured_image %}
        {{
          product.featured_image
          | image_url: width: 800
          | image_tag:
            class: 'product-card__image',
            widths: '300, 450, 600, 800',
            sizes: '(min-width: 990px) 28vw, (min-width: 750px) 40vw, 80vw',
            loading: 'lazy',
            alt: image_alt
        }}
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'product-card__placeholder' }}
      {% endif %}
    </a>

    {% if swatch_value != blank %}
      <div class="product-card__swatch">
        {% if swatch_value.swatch.image %}
          {{
            swatch_value.swatch.image
            | image_url: width: 80
            | image_tag: class: 'product-card__swatch-image', loading: 'lazy', alt: swatch_value.name
          }}
        {% elsif swatch_value.swatch.color %}
          <span
            class="product-card__swatch-color"
            style="background-color: {{ swatch_value.swatch.color }};"
            aria-hidden="true"
          ></span>
        {% else %}
          <span class="product-card__swatch-color product-card__swatch-color--fallback" aria-hidden="true"></span>
        {% endif %}
        <span class="product-card__swatch-label">{{ swatch_value.name | escape }}</span>
      </div>
    {% endif %}
  </div>

  <div class="product-card__info">
    {% if product.vendor != blank %}
      <p class="product-card__vendor">{{ product.vendor | escape }}</p>
    {% elsif product.collections.first %}
      <p class="product-card__vendor">{{ product.collections.first.title | escape }}</p>
    {% endif %}
    <h3 class="product-card__title">
      <a href="{{ product.url }}">{{ product.title | escape }}</a>
    </h3>
    <p class="product-card__price">{{ variant.price | money }}</p>
  </div>
</article>

{% stylesheet %}
  .product-card {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .product-card__stock {
    margin: 0;
    color: #8a8a8a;
    font-size: 0.72rem;
    letter-spacing: 0.02em;
  }

  .product-card__stock--sold-out {
    color: #b00000;
  }

  .product-card__media {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.75rem;
    align-items: start;
  }

  .product-card__image-link {
    display: block;
    background: #f3f3f3;
  }

  .product-card__image,
  .product-card__placeholder {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: contain;
    background: #f3f3f3;
  }

  .product-card__swatch {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    width: 4.5rem;
  }

  .product-card__swatch-image,
  .product-card__swatch-color {
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid rgba(17, 17, 17, 0.15);
  }

  .product-card__swatch-color--fallback {
    background: #ddd;
  }

  .product-card__swatch-label {
    font-size: 0.65rem;
    line-height: 1.2;
    color: #666;
  }

  .product-card__info {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .product-card__vendor,
  .product-card__title,
  .product-card__price {
    margin: 0;
  }

  .product-card__vendor {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #666;
  }

  .product-card__title {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1.35;
  }

  .product-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .product-card__title a:hover {
    text-decoration: underline;
  }

  .product-card__price {
    font-size: 0.9rem;
    font-weight: 600;
  }
{% endstylesheet %}
