{% comment %}
  Partner link buttons. Website stays a text button; socials use black brand icons.
{% endcomment %}
{% liquid
  assign site_label = website_label | strip
  if site_label == blank
    assign site_label = 'partnerships.view_site' | t
  endif
  assign extra_text = extra_label | strip
  if extra_text == blank
    assign extra_text = 'partnerships.more' | t
  endif
%}
{% if website != blank or youtube != blank or instagram != blank or tiktok != blank or facebook != blank or x != blank or extra != blank %}
  <div class="membership__actions partnerships__actions">
    {% if website != blank %}
      <a
        href="{{ website }}"
        class="membership__button membership__button--primary"
        target="_blank"
        rel="noopener noreferrer"
      >
        {{ site_label | escape }}
      </a>
    {% endif %}
    {% if instagram != blank %}
      <a
        href="{{ instagram }}"
        class="partnerships__icon-link"
        aria-label="{{ 'partnerships.instagram' | t | escape }}"
        target="_blank"
        rel="noopener noreferrer"
      >
        {% render 'icon-social', icon: 'instagram' %}
      </a>
    {% endif %}
    {% if youtube != blank %}
      <a
        href="{{ youtube }}"
        class="partnerships__icon-link"
        aria-label="{{ 'partnerships.youtube' | t | escape }}"
        target="_blank"
        rel="noopener noreferrer"
      >
        {% render 'icon-social', icon: 'youtube' %}
      </a>
    {% endif %}
    {% if tiktok != blank %}
      <a
        href="{{ tiktok }}"
        class="partnerships__icon-link"
        aria-label="{{ 'partnerships.tiktok' | t | escape }}"
        target="_blank"
        rel="noopener noreferrer"
      >
        {% render 'icon-social', icon: 'tiktok' %}
      </a>
    {% endif %}
    {% if facebook != blank %}
      <a
        href="{{ facebook }}"
        class="partnerships__icon-link"
        aria-label="{{ 'partnerships.facebook' | t | escape }}"
        target="_blank"
        rel="noopener noreferrer"
      >
        {% render 'icon-social', icon: 'facebook' %}
      </a>
    {% endif %}
    {% if x != blank %}
      <a
        href="{{ x }}"
        class="partnerships__icon-link"
        aria-label="{{ 'partnerships.x' | t | escape }}"
        target="_blank"
        rel="noopener noreferrer"
      >
        {% render 'icon-social', icon: 'x' %}
      </a>
    {% endif %}
    {% if extra != blank %}
      <a
        href="{{ extra }}"
        class="membership__button membership__button--secondary"
        target="_blank"
        rel="noopener noreferrer"
      >
        {{ extra_text | escape }}
      </a>
    {% endif %}
  </div>
{% endif %}
