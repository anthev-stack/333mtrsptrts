{% render 'section-padding' %}

{% liquid
  assign section_width = section.settings.section_width | default: 'full'
%}

{% if section.settings.message_left != blank or section.settings.message_right != blank %}
  <div class="announcement-bar announcement-bar--{{ section_width }} full-width" role="region" aria-label="Announcements">
    <div class="announcement-bar__inner">
      {% if section.settings.message_left != blank %}
        <p class="announcement-bar__message announcement-bar__message--left">
          {% if section.settings.link_left != blank %}
            <a href="{{ section.settings.link_left }}">{{ section.settings.message_left | escape }}</a>
          {% else %}
            {{ section.settings.message_left | escape }}
          {% endif %}
        </p>
      {% endif %}
      {% if section.settings.message_right != blank %}
        <p class="announcement-bar__message announcement-bar__message--right">
          {% if section.settings.link_right != blank %}
            <a href="{{ section.settings.link_right }}">{{ section.settings.message_right | escape }}</a>
          {% else %}
            {{ section.settings.message_right | escape }}
          {% endif %}
        </p>
      {% endif %}
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .announcement-bar {
    background: #111;
    color: #fff;
  }

  .announcement-bar__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    width: min(var(--page-width), 100%);
    min-height: 2.1rem;
    margin-inline: auto;
    padding-inline: var(--page-margin);
    box-sizing: border-box;
  }

  .announcement-bar--full .announcement-bar__inner {
    width: 100%;
  }

  .announcement-bar__message {
    display: flex;
    align-items: center;
    margin: 0;
    padding: 0.5rem 0;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .announcement-bar__message--left {
    justify-content: flex-start;
    text-align: left;
    padding-right: 1rem;
  }

  .announcement-bar__message--right {
    justify-content: flex-end;
    text-align: right;
    padding-left: 1rem;
    border-left: 1px solid rgba(255, 255, 255, 0.22);
  }

  .announcement-bar__message a {
    color: inherit;
    text-decoration: none;
  }

  .announcement-bar__message a:hover {
    text-decoration: underline;
  }

  @media screen and (max-width: 749px) {
    .announcement-bar__inner {
      grid-template-columns: 1fr;
    }

    .announcement-bar__message--left,
    .announcement-bar__message--right {
      justify-content: center;
      text-align: center;
      padding-inline: 0;
    }

    .announcement-bar__message--right {
      border-left: 0;
      border-top: 1px solid rgba(255, 255, 255, 0.22);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.announcement_bar",
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:labels.section_width",
      "options": [
        {
          "value": "page",
          "label": "t:options.section_width.page"
        },
        {
          "value": "full",
          "label": "t:options.section_width.full"
        }
      ],
      "default": "full"
    },
    {
      "type": "text",
      "id": "message_left",
      "label": "t:labels.message_left",
      "default": "Buy now. Pay later. Options available at checkout."
    },
    {
      "type": "url",
      "id": "link_left",
      "label": "t:labels.link_left"
    },
    {
      "type": "text",
      "id": "message_right",
      "label": "t:labels.message_right",
      "default": "Free domestic shipping on orders over $150. Conditions apply."
    },
    {
      "type": "url",
      "id": "link_right",
      "label": "t:labels.link_right"
    },
    {
      "type": "header",
      "content": "t:labels.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.padding_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.padding_bottom",
      "default": 0
    }
  ]
}
{% endschema %}
