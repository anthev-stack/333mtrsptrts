{% comment %}
  Team grid on About us — membership-style cards, 3 columns.
{% endcomment %}

{% render 'section-padding' %}

<section class="membership team" data-team>
  <div class="membership__inner">
    <h2 class="membership__title team__title">
      {% if section.settings.title != blank %}
        {{ section.settings.title | escape }}
      {% else %}
        {{ 'about.team_title' | t }}
      {% endif %}
    </h2>

    <div class="team__grid">
      {% for block in section.blocks %}
        {% liquid
          assign member_name = block.settings.name | strip
          assign member_role = block.settings.position | strip
          assign member_bio = block.settings.intro | strip_html | strip
        %}
        {% if block.settings.photo != blank or member_name != blank or member_role != blank or member_bio != blank %}
          <article class="membership__panel team__card" {{ block.shopify_attributes }}>
            <div class="team__top">
              <div class="team__identity">
                {% if member_name != blank %}
                  <h3 class="team__name">{{ member_name | escape }}</h3>
                {% endif %}
                {% if member_role != blank %}
                  <p class="team__role">{{ member_role | escape }}</p>
                {% endif %}
              </div>
              {% if block.settings.photo != blank %}
                {% assign member_alt = member_name | default: shop.name %}
                <div class="team__photo">
                  {{
                    block.settings.photo
                    | image_url: width: 240
                    | image_tag:
                      loading: 'lazy',
                      class: 'team__photo-img',
                      widths: '96, 160, 240',
                      sizes: '68px',
                      alt: member_alt
                  }}
                </div>
              {% endif %}
            </div>
            {% if member_bio != blank %}
              <div class="membership__benefits team__intro">{{ block.settings.intro }}</div>
            {% endif %}
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .team__title {
    margin-bottom: 1.25rem;
  }

  .team__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .team__card {
    display: flex;
    flex-direction: column;
  }

  .team__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .team__identity {
    min-width: 0;
    flex: 1;
  }

  .team__photo {
    flex: 0 0 4.25rem;
    width: 4.25rem;
    margin: 0;
  }

  .team__photo-img,
  .team__photo img {
    display: block;
    width: 4.25rem;
    height: 4.25rem;
    max-width: 4.25rem;
    object-fit: cover;
  }

  .team__name {
    margin: 0 0 0.3rem;
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1.2;
  }

  .team__role {
    margin: 0;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #666;
  }

  .team__intro {
    margin: 0.75rem 0 0;
  }

  @media screen and (min-width: 750px) {
    .team__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media screen and (min-width: 990px) {
    .team__grid {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.team",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:labels.title",
      "default": "The team"
    },
    {
      "type": "header",
      "content": "t:labels.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.padding_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.padding_bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "member",
      "name": "t:labels.team_member",
      "settings": [
        {
          "type": "image_picker",
          "id": "photo",
          "label": "t:labels.team_photo"
        },
        {
          "type": "text",
          "id": "name",
          "label": "t:labels.team_name"
        },
        {
          "type": "text",
          "id": "position",
          "label": "t:labels.team_position"
        },
        {
          "type": "richtext",
          "id": "intro",
          "label": "t:labels.team_intro"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "t:general.team"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
