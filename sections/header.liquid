{% liquid
  assign logo_scale = settings.logo_scale | default: 100
  assign logo_base_height = 64
  assign logo_height = logo_base_height | times: logo_scale | divided_by: 100
  if logo_height < 1
    assign logo_height = 1
  endif
  if settings.logo != blank and settings.logo.aspect_ratio != blank
    assign logo_width = logo_height | times: settings.logo.aspect_ratio | round
  else
    assign logo_width = logo_height | times: 2.4 | round
  endif
  if logo_width < 1
    assign logo_width = logo_height
  endif
  assign logo_sizes = logo_width | append: 'px'
  assign logo_style = 'width: ' | append: logo_width | append: 'px !important; height: ' | append: logo_height | append: 'px !important; max-width: none !important; max-height: none !important; object-fit: contain;'
  assign section_width = section.settings.section_width | default: 'page'
%}

{% comment %}
  Size must be in {% style %} so theme-editor changes apply immediately.
  critical.css sets img { max-width: 100%; height: auto; } which was locking the navbar logo.
{% endcomment %}
{% style %}
  #shopify-section-{{ section.id }} .site-header__logo {
    width: {{ logo_width }}px;
    height: {{ logo_height }}px;
  }

  #shopify-section-{{ section.id }} .site-header__logo-image {
    width: {{ logo_width }}px !important;
    height: {{ logo_height }}px !important;
    max-width: none !important;
    max-height: none !important;
    object-fit: contain !important;
    object-position: center;
  }
{% endstyle %}

{% render 'section-padding' %}

<div class="header-social header-social--{{ section_width }} full-width">
  <div class="header-social__inner">
    <div class="header-social__links">
      {% if section.settings.facebook_url != blank %}
        <a
          href="{{ section.settings.facebook_url }}"
          class="header-social__link"
          aria-label="Facebook"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M14 13.5h2.5l1-4H14v-2c0-1.03 0-2 2-2h1.5V2.14C17.17 2.09 15.84 2 14.67 2 11.95 2 10 3.66 10 6.7V9.5H7v4h3V22h4v-8.5z"/>
          </svg>
        </a>
      {% endif %}
      {% if section.settings.instagram_url != blank %}
        <a
          href="{{ section.settings.instagram_url }}"
          class="header-social__link"
          aria-label="Instagram"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5zm0 2a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3H7zm11 1.5a1 1 0 1 1 0 2 1 1 0 0 1 0-2zM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6z"/>
          </svg>
        </a>
      {% endif %}
    </div>

    {% if shop.customer_accounts_enabled %}
      <div class="header-social__account">
        {% if customer %}
          {% liquid
            assign account_name = customer.first_name | default: customer.name | default: customer.email
            assign membership_page_url = settings.membership_page_url | default: '/pages/membership'
          %}
          <a href="{{ routes.account_url }}" class="header-social__account-link header-social__account-link--name">
            {{ account_name | escape }}
          </a>
          <span class="header-social__account-meta header-social__account-meta--credit">
            {{ 'header.account_credit' | t }}:
            {% if customer.store_credit_account != blank %}
              {{ customer.store_credit_account.balance | money }}
            {% else %}
              {{ 0 | money }}
            {% endif %}
          </span>
          <span class="header-social__account-meta header-social__account-meta--orders">
            {{ 'header.account_orders' | t: count: customer.orders_count }}
          </span>
          <a href="{{ membership_page_url }}" class="header-social__account-link">
            {{ 'header.membership_card' | t }}
          </a>
          <a href="{{ routes.account_url }}" class="header-social__account-link">
            {{ 'header.account' | t }}
          </a>
          <a href="{{ routes.account_logout_url }}" class="header-social__account-link">
            {{ 'header.log_out' | t }}
          </a>
        {% else %}
          <a href="{{ routes.storefront_login_url }}" class="header-social__account-link">
            {{ 'header.log_in' | t }}
          </a>
          <a href="{{ routes.account_register_url }}" class="header-social__account-link">
            {{ 'header.create_account' | t }}
          </a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>

<header class="site-header site-header--{{ section_width }} full-width" data-site-header>
  <div class="site-header__inner">
    <button
      type="button"
      class="site-header__menu-toggle"
      data-menu-toggle
      aria-controls="HeaderMenu-{{ section.id }}"
      aria-expanded="false"
      aria-label="{{ 'header.menu' | t }}"
    >
      <span class="site-header__menu-toggle-icon" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </span>
    </button>

    <nav
      id="HeaderMenu-{{ section.id }}"
      class="site-header__nav"
      aria-label="Primary"
      data-header-nav
    >
      {% if section.settings.menu != blank %}
        <ul class="site-header__menu">
          {% for link in section.settings.menu.links %}
            {% liquid
              assign has_children = false
              assign has_mega = false
              assign show_shop_all_blurb = false
              assign link_title_normalized = link.title | downcase | strip

              if link_title_normalized == 'shop all' and section.settings.shop_all_enable
                assign show_shop_all_blurb = true
              endif

              if link.links != blank and link.links.size > 0
                assign has_children = true
                for child_link in link.links
                  if child_link.links != blank and child_link.links.size > 0
                    assign has_mega = true
                    break
                  endif
                endfor
              endif

              if show_shop_all_blurb
                assign has_mega = false
                assign has_children = true
              endif
            %}

            <li
              class="site-header__item{% if show_shop_all_blurb %} site-header__item--blurb{% elsif has_mega %} site-header__item--mega{% elsif has_children %} site-header__item--dropdown{% endif %}"
              {% if has_children or show_shop_all_blurb %}data-submenu-item{% endif %}
            >
              {% if has_children or show_shop_all_blurb %}
                <button
                  type="button"
                  class="site-header__link site-header__link--parent{% if link.active or link.child_active %} site-header__link--active{% endif %}"
                  data-submenu-toggle
                  aria-expanded="false"
                  aria-controls="HeaderSubmenu-{{ section.id }}-{{ forloop.index }}"
                >
                  {{ link.title | escape }}
                </button>
              {% else %}
                <a
                  href="{{ link.url }}"
                  class="site-header__link{% if link.active %} site-header__link--active{% endif %}"
                >
                  {{ link.title | escape }}
                </a>
              {% endif %}

              {% if show_shop_all_blurb %}
                <div
                  id="HeaderSubmenu-{{ section.id }}-{{ forloop.index }}"
                  class="site-header__blurb"
                  data-submenu-panel
                >
                  <div class="site-header__blurb-inner site-header__blurb-inner--{{ section_width }}">
                    {% if section.settings.shop_all_eyebrow != blank %}
                      <p class="site-header__blurb-eyebrow">{{ section.settings.shop_all_eyebrow | escape }}</p>
                    {% endif %}
                    {% if section.settings.shop_all_heading != blank %}
                      <h2 class="site-header__blurb-heading">{{ section.settings.shop_all_heading | escape }}</h2>
                    {% endif %}
                    {% if section.settings.shop_all_text != blank %}
                      <div class="site-header__blurb-text">{{ section.settings.shop_all_text }}</div>
                    {% endif %}
                    {% if section.settings.shop_all_button_1_label != blank or section.settings.shop_all_button_2_label != blank %}
                      <div class="site-header__blurb-actions">
                        {% if section.settings.shop_all_button_1_label != blank %}
                          <a
                            href="{{ section.settings.shop_all_button_1_link | default: link.url }}"
                            class="site-header__blurb-button site-header__blurb-button--secondary"
                          >
                            {{ section.settings.shop_all_button_1_label | escape }}
                          </a>
                        {% endif %}
                        {% if section.settings.shop_all_button_2_label != blank %}
                          <a
                            href="{{ section.settings.shop_all_button_2_link | default: routes.all_products_collection_url }}"
                            class="site-header__blurb-button site-header__blurb-button--primary"
                          >
                            {{ section.settings.shop_all_button_2_label | escape }}
                          </a>
                        {% endif %}
                      </div>
                    {% endif %}
                  </div>
                </div>
              {% elsif has_mega %}
                <div
                  id="HeaderSubmenu-{{ section.id }}-{{ forloop.index }}"
                  class="site-header__mega"
                  data-submenu-panel
                >
                  <div class="site-header__mega-inner site-header__mega-inner--{{ section_width }}">
                    {% for child_link in link.links %}
                      <div class="site-header__mega-column">
                        {% if child_link.url == blank or child_link.url == '#' %}
                          <p class="site-header__mega-heading">{{ child_link.title | escape }}</p>
                        {% else %}
                          <a href="{{ child_link.url }}" class="site-header__mega-heading">
                            {{ child_link.title | escape }}
                          </a>
                        {% endif %}

                        {% if child_link.links != blank %}
                          <ul class="site-header__mega-list">
                            {% for grandchild_link in child_link.links %}
                              <li>
                                <a
                                  href="{{ grandchild_link.url }}"
                                  class="site-header__mega-link{% if grandchild_link.active %} is-active{% endif %}"
                                >
                                  {{ grandchild_link.title | escape }}
                                </a>
                              </li>
                            {% endfor %}
                          </ul>
                        {% endif %}
                      </div>
                    {% endfor %}
                  </div>
                </div>
              {% elsif has_children %}
                <div
                  id="HeaderSubmenu-{{ section.id }}-{{ forloop.index }}"
                  class="site-header__dropdown"
                  data-submenu-panel
                >
                  <ul class="site-header__dropdown-list">
                    {% for child_link in link.links %}
                      <li>
                        <a
                          href="{{ child_link.url }}"
                          class="site-header__dropdown-link{% if child_link.active %} is-active{% endif %}"
                        >
                          {{ child_link.title | escape }}
                        </a>
                      </li>
                    {% endfor %}
                  </ul>
                </div>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </nav>

    <a
      href="{{ routes.root_url }}"
      class="site-header__logo"
      style="width: {{ logo_width }}px; height: {{ logo_height }}px;"
    >
      {% if settings.logo != blank %}
        {{
          settings.logo
          | image_url: width: 1200
          | image_tag:
            class: 'site-header__logo-image',
            widths: '120, 240, 360, 480, 720, 960, 1200',
            sizes: logo_sizes,
            width: logo_width,
            height: logo_height,
            alt: shop.name,
            loading: 'eager',
            style: logo_style
        }}
      {% else %}
        <span class="site-header__logo-text">{{ shop.name }}</span>
      {% endif %}
    </a>

    <div class="site-header__actions">
      {% if settings.partbot_demo_mode %}
        <button
          type="button"
          class="site-header__pl8srch"
          aria-label="{{ 'partbot.demo_plate_search' | t }}"
          title="{{ 'partbot.demo_plate_search' | t }}"
          aria-haspopup="dialog"
          aria-controls="Pl8srchModal"
          data-pl8srch-open
        >
          <span class="site-header__pl8srch-plate">
            <svg
              class="site-header__pl8srch-icon"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
              focusable="false"
            >
              <path d="M7.2 8.2c.45-1.55 1.85-2.55 3.5-2.55h2.6c1.65 0 3.05 1 3.5 2.55l.55 1.9H6.65l.55-1.9z"/>
              <path d="M5.2 11.4h13.6c.9 0 1.6.7 1.6 1.55v2.7c0 .55-.45 1-1 1h-.55c-.2 1.05-1.1 1.85-2.2 1.85s-2-.8-2.2-1.85h-4.1c-.2 1.05-1.1 1.85-2.2 1.85s-2-.8-2.2-1.85H4.6c-.55 0-1-.45-1-1v-2.7c0-.85.7-1.55 1.6-1.55z"/>
              <path fill="#fff" d="M8.35 9.05h7.3c.3 0 .5.28.4.55l-.35.85H8.3l-.35-.85c-.1-.27.1-.55.4-.55z"/>
              <rect x="6.7" y="12.55" width="2.35" height="1.05" rx="0.2" fill="#fff"/>
              <rect x="14.95" y="12.55" width="2.35" height="1.05" rx="0.2" fill="#fff"/>
            </svg>
            <span class="site-header__pl8srch-text">PL8SRCH</span>
          </span>
        </button>
      {% endif %}
      <a href="{{ routes.search_url }}" class="site-header__action">
        <span>{{ 'header.search' | t }}</span>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="M20 20l-3.5-3.5"></path>
        </svg>
      </a>
      <a
        href="{{ routes.cart_url }}"
        class="site-header__action"
        data-cart-drawer-open
        aria-haspopup="dialog"
      >
        <span>{{ 'header.cart' | t }}</span>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          <path d="M6 6h15l-1.5 9h-12z"></path>
          <path d="M6 6l-1-3H2"></path>
          <circle cx="9" cy="20" r="1.5"></circle>
          <circle cx="18" cy="20" r="1.5"></circle>
        </svg>
        <sup class="site-header__cart-count" data-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>
          {{ cart.item_count }}
        </sup>
      </a>
    </div>
  </div>
</header>

{% if settings.partbot_demo_mode %}
  {% render 'pl8srch-modal' %}
{% endif %}

{% stylesheet %}
  .header-social {
    background: #111;
    color: #fff;
  }

  .header-social__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem;
    width: min(var(--page-width), 100%);
    min-height: 2.1rem;
    margin-inline: auto;
    padding: 0.5rem var(--page-margin);
    box-sizing: border-box;
  }

  .header-social--full .header-social__inner {
    width: 100%;
  }

  .header-social__links {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    min-width: 0;
  }

  .header-social__link {
    display: inline-flex;
    color: #fff;
    opacity: 0.85;
    transition: opacity 0.2s ease;
  }

  .header-social__link:hover {
    opacity: 1;
  }

  .header-social__account {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.35rem 0.75rem;
    margin-left: auto;
    min-width: 0;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1.2;
  }

  .header-social__account-link {
    color: #fff;
    text-decoration: none;
    opacity: 0.9;
    white-space: nowrap;
    transition: opacity 0.2s ease;
  }

  .header-social__account-link:hover {
    opacity: 1;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .header-social__account-link--name {
    max-width: 10rem;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .header-social__account-meta {
    color: rgba(255, 255, 255, 0.72);
    white-space: nowrap;
  }

  @media screen and (max-width: 749px) {
    .header-social__account {
      gap: 0.3rem 0.55rem;
      font-size: 0.58rem;
    }

    .header-social__account-meta--orders {
      display: none;
    }
  }

  .site-header {
    position: relative;
    background: var(--color-background);
    z-index: 30;
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.25rem;
    width: min(var(--page-width), 100%);
    min-height: 4.25rem;
    margin-inline: auto;
    padding: 0.65rem var(--page-margin);
    box-sizing: border-box;
  }

  .site-header--full .site-header__inner {
    width: 100%;
  }

  .site-header__menu-toggle {
    display: none;
    appearance: none;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-foreground);
    cursor: pointer;
    position: relative;
    z-index: 2;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  .site-header__menu-toggle-icon {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 1.15rem;
    height: 0.85rem;
  }

  .site-header__menu-toggle-icon span {
    display: block;
    width: 100%;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .site-header.is-menu-open .site-header__menu-toggle-icon span:nth-child(1) {
    transform: translateY(5.5px) rotate(45deg);
  }

  .site-header.is-menu-open .site-header__menu-toggle-icon span:nth-child(2) {
    opacity: 0;
  }

  .site-header.is-menu-open .site-header__menu-toggle-icon span:nth-child(3) {
    transform: translateY(-5.5px) rotate(-45deg);
  }

  .site-header__menu {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.1rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .site-header__item {
    position: static;
  }

  .site-header__link {
    appearance: none;
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 0;
    border: 0;
    background: transparent;
    font-family: var(--font-navigation--family);
    font-style: var(--font-navigation--style);
    font-weight: var(--font-navigation--weight);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-foreground);
    cursor: pointer;
  }

  .site-header__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.3rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: center;
    opacity: 0;
    transition: transform 0.4s ease, opacity 0.4s ease;
  }

  .site-header__link:hover::after,
  .site-header__link--active::after,
  .site-header__item.is-open > .site-header__link::after,
  .site-header__item:hover > .site-header__link::after,
  .site-header__item:focus-within > .site-header__link::after {
    transform: scaleX(1);
    opacity: 1;
  }

  .site-header__mega,
  .site-header__dropdown,
  .site-header__blurb {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    z-index: 40;
    background: #fff;
    border-top: 1px solid rgba(17, 17, 17, 0.1);
    border-bottom: 1px solid rgba(17, 17, 17, 0.1);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.2s ease, visibility 0.2s ease;
  }

  /* Invisible bridge so the pointer can travel from the nav label into the panel */
  .site-header__mega::before,
  .site-header__dropdown::before,
  .site-header__blurb::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 100%;
    height: 1.75rem;
  }

  .site-header__item.is-open > .site-header__mega,
  .site-header__item:hover > .site-header__mega,
  .site-header__item:focus-within > .site-header__mega,
  .site-header__item.is-open > .site-header__dropdown,
  .site-header__item:hover > .site-header__dropdown,
  .site-header__item:focus-within > .site-header__dropdown,
  .site-header__item.is-open > .site-header__blurb,
  .site-header__item:hover > .site-header__blurb,
  .site-header__item:focus-within > .site-header__blurb {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .site-header__blurb-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    width: min(var(--page-width), 100%);
    max-width: 42rem;
    margin-inline: auto;
    padding: 2.5rem var(--page-margin) 2.75rem;
    text-align: center;
    box-sizing: border-box;
  }

  .site-header__blurb-inner--full {
    width: 100%;
  }

  .site-header__blurb-eyebrow {
    margin: 0;
    color: #8a8a8a;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .site-header__blurb-heading {
    margin: 0;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .site-header__blurb-text {
    color: #666;
    font-size: 0.78rem;
    line-height: 1.7;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .site-header__blurb-text p {
    margin: 0;
  }

  .site-header__blurb-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.65rem;
    margin-top: 0.5rem;
  }

  .site-header__blurb-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.5rem;
    padding: 0.55rem 1.25rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .site-header__blurb-button--secondary {
    border: 1px solid #111;
    background: #fff;
    color: #111;
  }

  .site-header__blurb-button--secondary:hover {
    background: #111;
    color: #fff;
  }

  .site-header__blurb-button--primary {
    border: 1px solid #111;
    background: #111;
    color: #fff;
  }

  .site-header__blurb-button--primary:hover {
    background: #000;
  }

  .site-header__mega-inner {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem 2rem;
    width: min(var(--page-width), 100%);
    margin-inline: auto;
    padding: 1.5rem var(--page-margin) 1.75rem;
    box-sizing: border-box;
  }

  .site-header__mega-inner--full {
    width: 100%;
  }

  .site-header__mega-heading {
    display: block;
    margin: 0 0 0.75rem;
    color: #8a8a8a;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .site-header__mega-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .site-header__mega-link {
    font-family: var(--font-navigation--family);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-foreground);
  }

  .site-header__mega-link:hover,
  .site-header__mega-link.is-active {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .site-header__dropdown {
    left: auto;
    right: auto;
    min-width: 12rem;
    width: max-content;
    border: 1px solid rgba(17, 17, 17, 0.1);
  }

  .site-header__item--dropdown {
    position: relative;
  }

  .site-header__dropdown-list {
    list-style: none;
    margin: 0;
    padding: 0.65rem 0;
  }

  .site-header__dropdown-link {
    display: block;
    padding: 0.55rem 1rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-foreground);
  }

  .site-header__dropdown-link:hover,
  .site-header__dropdown-link.is-active {
    background: #f5f5f5;
  }

  .site-header__logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    text-decoration: none;
    color: var(--color-foreground);
    justify-self: center;
    line-height: 0;
    overflow: hidden;
  }

  .site-header__logo-image {
    display: block;
    flex: 0 0 auto;
    max-width: none;
    max-height: none;
    object-fit: contain;
    object-position: center;
  }

  .site-header__logo-text {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 800;
    font-style: italic;
    letter-spacing: -0.02em;
    line-height: 1;
    text-transform: uppercase;
  }

  .site-header__actions {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 1.15rem;
  }

  .site-header__pl8srch {
    appearance: none;
    display: inline-flex;
    align-items: center;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .site-header__pl8srch-plate {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 1.7rem;
    padding: 0.22rem 0.5rem;
    border: 2px solid var(--color-accent, #f5c518);
    background: #fff;
    color: #111;
    border-radius: 0;
    box-sizing: border-box;
  }

  .site-header__pl8srch-icon {
    flex-shrink: 0;
    display: block;
    width: 1.05rem;
    height: 1.05rem;
    color: #111;
  }

  .site-header__pl8srch-text {
    font-family: var(--font-navigation--family);
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
  }

  .site-header__action {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-navigation--family);
    font-style: var(--font-navigation--style);
    font-weight: var(--font-navigation--weight);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: var(--font-navigation--decoration);
    color: var(--color-foreground);
  }

  .site-header__cart-count {
    position: absolute;
    top: -0.45rem;
    right: -0.7rem;
    font-size: 0.65rem;
  }

  body.site-header-menu-open {
    overflow: hidden;
  }

  @media screen and (max-width: 749px) {
    .site-header__inner {
      grid-template-columns: 2.5rem 1fr auto;
      gap: 0.75rem;
    }

    .site-header__menu-toggle {
      display: inline-flex;
      justify-self: start;
    }

    .site-header__logo {
      justify-self: center;
    }

    .site-header__nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      z-index: 30;
      background: var(--color-background);
      border-bottom: 1px solid rgba(17, 17, 17, 0.12);
      padding: 0.75rem var(--page-margin) 1rem;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06);
    }

    .site-header__nav.is-open {
      display: block;
    }

    .site-header__menu {
      flex-direction: column;
      flex-wrap: nowrap;
      align-items: stretch;
      gap: 0;
    }

    .site-header__item + .site-header__item {
      border-top: 1px solid rgba(17, 17, 17, 0.08);
    }

    .site-header__link {
      display: flex;
      width: 100%;
      padding: 0.85rem 0;
      justify-content: space-between;
    }

    .site-header__link--active::after,
    .site-header__link:hover::after,
    .site-header__item.is-open > .site-header__link::after,
    .site-header__item:hover > .site-header__link::after {
      display: none;
    }

    .site-header__mega,
    .site-header__dropdown,
    .site-header__blurb {
      position: static;
      border: 0;
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: none;
      display: none;
      background: transparent;
    }

    .site-header__item.is-open > .site-header__mega,
    .site-header__item.is-open > .site-header__dropdown,
    .site-header__item.is-open > .site-header__blurb {
      display: block;
    }

    .site-header__item:hover > .site-header__mega,
    .site-header__item:focus-within > .site-header__mega,
    .site-header__item:hover > .site-header__dropdown,
    .site-header__item:focus-within > .site-header__dropdown,
    .site-header__item:hover > .site-header__blurb,
    .site-header__item:focus-within > .site-header__blurb {
      display: none;
    }

    .site-header__item.is-open:hover > .site-header__mega,
    .site-header__item.is-open:focus-within > .site-header__mega,
    .site-header__item.is-open:hover > .site-header__dropdown,
    .site-header__item.is-open:focus-within > .site-header__dropdown,
    .site-header__item.is-open:hover > .site-header__blurb,
    .site-header__item.is-open:focus-within > .site-header__blurb {
      display: block;
    }

    .site-header__blurb-inner {
      max-width: none;
      width: 100%;
      margin: 0;
      padding: 0.25rem 0 1rem;
      align-items: flex-start;
      text-align: left;
    }

    .site-header__blurb-actions {
      justify-content: flex-start;
    }

    .site-header__mega-inner {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      width: 100%;
      margin: 0;
      padding: 0 0 0.75rem;
    }

    .site-header__mega-heading {
      margin-bottom: 0.45rem;
    }

    .site-header__dropdown-list {
      padding: 0 0 0.75rem;
    }

    .site-header__dropdown-link {
      padding-left: 0;
      padding-right: 0;
    }

    .site-header__action span {
      display: none;
    }

    .site-header__pl8srch-text {
      display: none;
    }

    .site-header__pl8srch-plate {
      min-height: 1.85rem;
      padding: 0.25rem 0.4rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:labels.section_width",
      "options": [
        {
          "value": "page",
          "label": "t:options.section_width.page"
        },
        {
          "value": "full",
          "label": "t:options.section_width.full"
        }
      ],
      "default": "page"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    },
    {
      "type": "text",
      "id": "facebook_url",
      "label": "t:labels.facebook_url",
      "default": "https://facebook.com"
    },
    {
      "type": "text",
      "id": "instagram_url",
      "label": "t:labels.instagram_url",
      "default": "https://instagram.com"
    },
    {
      "type": "header",
      "content": "t:labels.shop_all_blurb"
    },
    {
      "type": "checkbox",
      "id": "shop_all_enable",
      "label": "t:labels.shop_all_enable",
      "default": true,
      "info": "t:labels.shop_all_enable_info"
    },
    {
      "type": "text",
      "id": "shop_all_eyebrow",
      "label": "t:labels.eyebrow",
      "default": "333 Motorsports"
    },
    {
      "type": "text",
      "id": "shop_all_heading",
      "label": "t:labels.heading",
      "default": "Wide menu"
    },
    {
      "type": "richtext",
      "id": "shop_all_text",
      "label": "t:labels.text",
      "default": "<p>Browse the full range of car care, maintenance, and performance products. Quality gear for enthusiasts who want their vehicle looking and running at its best.</p>"
    },
    {
      "type": "text",
      "id": "shop_all_button_1_label",
      "label": "t:labels.button_1_label",
      "default": "Shop this"
    },
    {
      "type": "url",
      "id": "shop_all_button_1_link",
      "label": "t:labels.button_1_link"
    },
    {
      "type": "text",
      "id": "shop_all_button_2_label",
      "label": "t:labels.button_2_label",
      "default": "Shop all"
    },
    {
      "type": "url",
      "id": "shop_all_button_2_link",
      "label": "t:labels.button_2_link"
    },
    {
      "type": "header",
      "content": "t:labels.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.padding_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.padding_bottom",
      "default": 0
    }
  ]
}
{% endschema %}
