{% liquid
  assign logo_width = settings.logo_width | default: 120
  assign logo_width_2x = logo_width | times: 2
%}

<div class="header-social full-width">
  <div class="header-social__inner">
    {% if section.settings.facebook_url != blank %}
      <a
        href="{{ section.settings.facebook_url }}"
        class="header-social__link"
        aria-label="Facebook"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M14 13.5h2.5l1-4H14v-2c0-1.03 0-2 2-2h1.5V2.14C17.17 2.09 15.84 2 14.67 2 11.95 2 10 3.66 10 6.7V9.5H7v4h3V22h4v-8.5z"/>
        </svg>
      </a>
    {% endif %}
    {% if section.settings.instagram_url != blank %}
      <a
        href="{{ section.settings.instagram_url }}"
        class="header-social__link"
        aria-label="Instagram"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5zm0 2a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3H7zm11 1.5a1 1 0 1 1 0 2 1 1 0 0 1 0-2zM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6z"/>
        </svg>
      </a>
    {% endif %}
  </div>
</div>

<header class="site-header full-width">
  <div class="site-header__inner">
    <nav class="site-header__nav" aria-label="Primary">
      {% if section.settings.menu != blank %}
        <ul class="site-header__menu">
          {% for link in section.settings.menu.links %}
            <li>
              <a
                href="{{ link.url }}"
                class="site-header__link{% if link.active %} site-header__link--active{% endif %}"
              >
                {{ link.title | escape }}
              </a>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </nav>

    <a href="{{ routes.root_url }}" class="site-header__logo">
      {% if settings.logo != blank %}
        {{
          settings.logo
          | image_url: width: logo_width_2x
          | image_tag:
            class: 'site-header__logo-image',
            width: logo_width,
            alt: shop.name,
            loading: 'eager'
        }}
      {% else %}
        <span class="site-header__logo-text">{{ shop.name }}</span>
      {% endif %}
    </a>

    <div class="site-header__actions">
      <a href="{{ routes.search_url }}" class="site-header__action">
        <span>{{ 'header.search' | t }}</span>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="M20 20l-3.5-3.5"></path>
        </svg>
      </a>
      <a href="{{ routes.cart_url }}" class="site-header__action">
        <span>{{ 'header.cart' | t }}</span>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          <path d="M6 6h15l-1.5 9h-12z"></path>
          <path d="M6 6l-1-3H2"></path>
          <circle cx="9" cy="20" r="1.5"></circle>
          <circle cx="18" cy="20" r="1.5"></circle>
        </svg>
        {% if cart.item_count > 0 %}
          <sup class="site-header__cart-count">{{ cart.item_count }}</sup>
        {% endif %}
      </a>
    </div>
  </div>
</header>

{% stylesheet %}
  .header-social {
    background: #111;
    color: #fff;
  }

  .header-social__inner {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    width: min(var(--page-width), 100%);
    min-height: 1.35rem;
    margin-inline: auto;
    padding: 0.3rem var(--page-margin);
    box-sizing: border-box;
  }

  .header-social__link {
    display: inline-flex;
    color: #fff;
    opacity: 0.85;
    transition: opacity 0.2s ease;
  }

  .header-social__link:hover {
    opacity: 1;
  }

  .site-header {
    background: var(--color-background);
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.25rem;
    width: min(var(--page-width), 100%);
    min-height: 4.25rem;
    margin-inline: auto;
    padding: 0.65rem var(--page-margin);
    box-sizing: border-box;
  }

  .site-header__menu {
    display: flex;
    flex-wrap: wrap;
    gap: 1.1rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .site-header__link {
    position: relative;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-foreground);
  }

  .site-header__link--active::after,
  .site-header__link:hover::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.3rem;
    height: 1px;
    background: currentColor;
  }

  .site-header__logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    color: var(--color-foreground);
    justify-self: center;
  }

  .site-header__logo-image {
    width: auto;
    height: auto;
    max-height: 3.25rem;
    max-width: {{ settings.logo_width | default: 120 }}px;
    object-fit: contain;
  }

  .site-header__logo-text {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 800;
    font-style: italic;
    letter-spacing: -0.02em;
    line-height: 1;
    text-transform: uppercase;
  }

  .site-header__actions {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 1.15rem;
  }

  .site-header__action {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-foreground);
  }

  .site-header__cart-count {
    position: absolute;
    top: -0.45rem;
    right: -0.7rem;
    font-size: 0.65rem;
  }

  @media screen and (max-width: 749px) {
    .site-header__inner {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        'logo actions'
        'nav nav';
      row-gap: 0.75rem;
    }

    .site-header__logo {
      grid-area: logo;
      justify-self: start;
    }

    .site-header__actions {
      grid-area: actions;
    }

    .site-header__nav {
      grid-area: nav;
      overflow-x: auto;
    }

    .site-header__menu {
      flex-wrap: nowrap;
      gap: 1rem;
    }

    .site-header__action span {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    },
    {
      "type": "text",
      "id": "facebook_url",
      "label": "t:labels.facebook_url",
      "default": "https://facebook.com"
    },
    {
      "type": "text",
      "id": "instagram_url",
      "label": "t:labels.instagram_url",
      "default": "https://instagram.com"
    }
  ]
}
{% endschema %}
