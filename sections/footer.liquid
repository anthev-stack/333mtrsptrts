{% liquid
  assign section_width = section.settings.section_width | default: 'page'
  assign brand_heading = section.settings.brand_heading | default: shop.name
  assign width_class = 'full-width'
%}

{% render 'section-padding' %}

<footer
  class="site-footer site-footer--{{ section_width }} {{ width_class }}"
  style="background-color: {{ section.settings.background_color }};"
>
  <div class="site-footer__inner">
    <div class="site-footer__grid">
      <div class="site-footer__col site-footer__col--brand">
        {% if brand_heading != blank %}
          <h2 class="site-footer__heading">{{ brand_heading | escape }}</h2>
        {% endif %}

        {% if section.settings.brand_text != blank %}
          <div class="site-footer__text">
            {{ section.settings.brand_text }}
          </div>
        {% endif %}

        {% if section.settings.facebook_url != blank or section.settings.instagram_url != blank %}
          <div class="site-footer__social">
            {% if section.settings.facebook_url != blank %}
              <a
                href="{{ section.settings.facebook_url }}"
                class="site-footer__social-link"
                aria-label="Facebook"
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M14 13.5h2.5l1-4H14v-2c0-1.03 0-2 2-2h1.5V2.14C17.17 2.09 15.84 2 14.67 2 11.95 2 10 3.66 10 6.7V9.5H7v4h3V22h4v-8.5z"/>
                </svg>
              </a>
            {% endif %}
            {% if section.settings.instagram_url != blank %}
              <a
                href="{{ section.settings.instagram_url }}"
                class="site-footer__social-link"
                aria-label="Instagram"
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5zm0 2a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3H7zm11 1.5a1 1 0 1 1 0 2 1 1 0 0 1 0-2zM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6z"/>
                </svg>
              </a>
            {% endif %}
          </div>
        {% endif %}
      </div>

      <div class="site-footer__col site-footer__col--links">
        {% if section.settings.links_heading != blank %}
          <h2 class="site-footer__heading">{{ section.settings.links_heading | escape }}</h2>
        {% endif %}

        {% if section.settings.menu != blank %}
          <ul class="site-footer__menu">
            {% for link in section.settings.menu.links %}
              <li>
                <a href="{{ link.url }}">{{ link.title | escape }}</a>
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>

      <div class="site-footer__col site-footer__col--newsletter">
        {% if section.settings.newsletter_heading != blank %}
          <h2 class="site-footer__heading">{{ section.settings.newsletter_heading | escape }}</h2>
        {% endif %}

        {% if section.settings.newsletter_text != blank %}
          <div class="site-footer__text">
            {{ section.settings.newsletter_text }}
          </div>
        {% endif %}

        {% form 'customer', class: 'site-footer__form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label class="visually-hidden" for="FooterNewsletterEmail-{{ section.id }}">
            {{ 'newsletter.email' | t }}
          </label>
          <input
            id="FooterNewsletterEmail-{{ section.id }}"
            type="email"
            name="contact[email]"
            class="site-footer__input"
            value="{{ form.email }}"
            placeholder="{{ section.settings.newsletter_placeholder | escape }}"
            required
            autocomplete="email"
          >
          <button type="submit" class="site-footer__button">
            {{ section.settings.newsletter_button | escape }}
          </button>

          {% if form.posted_successfully? %}
            <p class="site-footer__form-message">{{ 'newsletter.success' | t }}</p>
          {% endif %}
          {% if form.errors %}
            <p class="site-footer__form-message site-footer__form-message--error">
              {{ form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email }}
            </p>
          {% endif %}
        {% endform %}
      </div>
    </div>

    <div class="site-footer__bottom">
      <p class="site-footer__copyright">
        &copy; {{ 'now' | date: '%Y' }}
        {{ brand_heading | upcase | escape }}
      </p>
    </div>
  </div>
</footer>

{% stylesheet %}
  .site-footer {
    color: var(--color-foreground);
  }

  .site-footer__inner {
    width: min(var(--page-width), 100%);
    margin-inline: auto;
    padding-inline: var(--page-margin);
    box-sizing: border-box;
  }

  .site-footer--full .site-footer__inner {
    width: 100%;
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr;
    gap: clamp(1.75rem, 4vw, 3rem);
  }

  .site-footer__heading {
    margin: 0 0 0.9rem;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .site-footer__text {
    color: #555;
    font-size: 0.86rem;
    line-height: 1.65;
  }

  .site-footer__text p {
    margin: 0 0 0.75rem;
  }

  .site-footer__text p:last-child {
    margin-bottom: 0;
  }

  .site-footer__social {
    display: flex;
    gap: 0.85rem;
    margin-top: 1.15rem;
  }

  .site-footer__social-link {
    display: inline-flex;
    color: var(--color-foreground);
    opacity: 0.85;
    transition: opacity 0.2s ease;
  }

  .site-footer__social-link:hover {
    opacity: 1;
  }

  .site-footer__menu {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .site-footer__menu a {
    color: #555;
    font-size: 0.86rem;
    text-decoration: none;
  }

  .site-footer__menu a:hover {
    color: var(--color-foreground);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .site-footer__form {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    margin-top: 0.85rem;
    max-width: 18rem;
  }

  .site-footer__input {
    width: 100%;
    min-height: 2.6rem;
    padding: 0.65rem 0.8rem;
    border: 1px solid #cfcfcf;
    background: #fff;
    color: var(--color-foreground);
    box-sizing: border-box;
  }

  .site-footer__input::placeholder {
    color: #9a9a9a;
  }

  .site-footer__button {
    appearance: none;
    width: 100%;
    min-height: 2.6rem;
    border: 0;
    background: #111;
    color: #fff;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .site-footer__button:hover {
    background: #000;
  }

  .site-footer__form-message {
    margin: 0;
    font-size: 0.8rem;
    color: #555;
  }

  .site-footer__form-message--error {
    color: #b00000;
  }

  .site-footer__bottom {
    margin-top: clamp(2rem, 4vw, 2.75rem);
    padding-top: 1rem;
    border-top: 1px solid rgba(17, 17, 17, 0.12);
  }

  .site-footer__copyright {
    margin: 0;
    color: #8a8a8a;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media screen and (max-width: 989px) {
    .site-footer__grid {
      grid-template-columns: 1fr 1fr;
    }

    .site-footer__col--brand {
      grid-column: 1 / -1;
    }
  }

  @media screen and (max-width: 549px) {
    .site-footer__grid {
      grid-template-columns: 1fr;
    }

    .site-footer__form {
      max-width: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.footer",
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:labels.section_width",
      "options": [
        {
          "value": "page",
          "label": "t:options.section_width.page"
        },
        {
          "value": "full",
          "label": "t:options.section_width.full"
        }
      ],
      "default": "page"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background",
      "default": "#F5F5F5"
    },
    {
      "type": "header",
      "content": "t:labels.brand"
    },
    {
      "type": "text",
      "id": "brand_heading",
      "label": "t:labels.heading",
      "default": "333 Motorsports"
    },
    {
      "type": "richtext",
      "id": "brand_text",
      "label": "t:labels.text",
      "default": "<p>Your home of top-quality products. Car care, maintenance and more, we aim to offer everything you need to keep your vehicle in mint condition. With a passion for quality, performance and reliability, we strive to deliver the best products and customer service to car enthusiasts like you.</p>"
    },
    {
      "type": "text",
      "id": "facebook_url",
      "label": "t:labels.facebook_url",
      "default": "https://facebook.com"
    },
    {
      "type": "text",
      "id": "instagram_url",
      "label": "t:labels.instagram_url",
      "default": "https://instagram.com"
    },
    {
      "type": "header",
      "content": "t:labels.quick_links"
    },
    {
      "type": "text",
      "id": "links_heading",
      "label": "t:labels.heading",
      "default": "Quick links"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "footer"
    },
    {
      "type": "header",
      "content": "t:labels.newsletter"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "t:labels.heading",
      "default": "Newsletter"
    },
    {
      "type": "richtext",
      "id": "newsletter_text",
      "label": "t:labels.text",
      "default": "<p>Sign up to our newsletter for exclusive offers, products, events and more.</p>"
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "t:labels.email_placeholder",
      "default": "Your email"
    },
    {
      "type": "text",
      "id": "newsletter_button",
      "label": "t:labels.button_label",
      "default": "Subscribe"
    },
    {
      "type": "header",
      "content": "t:labels.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.padding_top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.padding_bottom",
      "default": 28
    }
  ]
}
{% endschema %}
