{% liquid
  assign section_width = section.settings.section_width | default: 'page'
  assign width_class = ''
  if section_width == 'full'
    assign width_class = 'full-width'
  endif
%}

<div class="promo-banners promo-banners--{{ section_width }} {{ width_class }}">
  {% for block in section.blocks %}
    <a
      class="promo-banner"
      href="{{ block.settings.link | default: routes.all_products_collection_url }}"
      {{ block.shopify_attributes }}
    >
      {% if block.settings.image != blank %}
        {{
          block.settings.image
          | image_url: width: 1600
          | image_tag:
            class: 'promo-banner__image',
            widths: '600, 900, 1200, 1600',
            sizes: '(min-width: 750px) 50vw, 100vw',
            loading: 'eager',
            alt: block.settings.title
        }}
      {% else %}
        <div class="promo-banner__placeholder" aria-hidden="true"></div>
      {% endif %}
      <div class="promo-banner__content">
        {% if block.settings.title != blank %}
          <h2 class="promo-banner__title">{{ block.settings.title | escape }}</h2>
        {% endif %}
        {% if block.settings.button_label != blank %}
          <span class="promo-banner__button">{{ block.settings.button_label | escape }}</span>
        {% endif %}
      </div>
    </a>
  {% endfor %}
</div>

{% stylesheet %}
  .promo-banners {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .promo-banners--full {
    gap: 0;
  }

  .promo-banners--page {
    gap: 0.75rem;
  }

  .promo-banner {
    position: relative;
    display: block;
    min-height: clamp(16rem, 32vw, 24rem);
    overflow: hidden;
    color: #fff;
    text-decoration: none;
  }

  .promo-banner__image,
  .promo-banner__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .promo-banner__placeholder {
    background:
      linear-gradient(135deg, rgba(17, 17, 17, 0.35), rgba(17, 17, 17, 0.55)),
      linear-gradient(120deg, #3a3a3a, #1a1a1a);
  }

  .promo-banner::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.35) 0%,
      rgba(0, 0, 0, 0.15) 40%,
      rgba(0, 0, 0, 0.45) 100%
    );
  }

  .promo-banner__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    min-height: inherit;
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .promo-banner__title {
    margin: 0;
    font-size: clamp(1.35rem, 2.4vw, 2rem);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .promo-banner__button {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    justify-content: center;
    min-height: 2.5rem;
    padding: 0.65rem 1.35rem;
    background: #111;
    color: #fff;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: transform 0.25s ease, background-color 0.25s ease;
  }

  .promo-banner:hover .promo-banner__button {
    background: #000;
    transform: translateY(-2px);
  }

  .promo-banner__image {
    transition: transform 0.6s ease;
  }

  .promo-banner:hover .promo-banner__image {
    transform: scale(1.04);
  }

  @media screen and (max-width: 749px) {
    .promo-banners {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.promo_banners",
  "max_blocks": 2,
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:labels.section_width",
      "options": [
        {
          "value": "page",
          "label": "t:options.section_width.page"
        },
        {
          "value": "full",
          "label": "t:options.section_width.full"
        }
      ],
      "default": "page"
    }
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "t:general.banner",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:labels.title",
          "default": "Car care"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "t:labels.button_label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:labels.link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.promo_banners",
      "settings": {
        "section_width": "page"
      },
      "blocks": [
        {
          "type": "banner",
          "settings": {
            "title": "Car care",
            "button_label": "Shop now"
          }
        },
        {
          "type": "banner",
          "settings": {
            "title": "Maintenance",
            "button_label": "Shop now"
          }
        }
      ]
    }
  ]
}
{% endschema %}
