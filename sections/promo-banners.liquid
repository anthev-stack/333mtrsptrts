{% liquid
  assign section_width = section.settings.section_width | default: 'page'
  assign width_class = ''
  if section_width == 'full'
    assign width_class = 'full-width'
  endif
%}

{% render 'section-padding' %}

<div class="promo-banners promo-banners--{{ section_width }} {{ width_class }}">
  {% for block in section.blocks %}
    {% liquid
      assign banner_ratio = 16.0 | divided_by: 9.0
      if block.settings.image != blank
        assign banner_ratio = block.settings.image.aspect_ratio
      endif
    %}
    <a
      class="promo-banner"
      href="{{ block.settings.link | default: routes.all_products_collection_url }}"
      style="--banner-ratio: {{ banner_ratio }};"
      {{ block.shopify_attributes }}
    >
      {% if block.settings.image != blank %}
        {{
          block.settings.image
          | image_url: width: 1600
          | image_tag:
            class: 'promo-banner__image',
            widths: '600, 900, 1200, 1600',
            sizes: '(min-width: 750px) 50vw, 100vw',
            loading: 'eager',
            alt: block.settings.title
        }}
      {% else %}
        <div class="promo-banner__placeholder" aria-hidden="true"></div>
      {% endif %}
      <div class="promo-banner__content">
        {% if block.settings.title != blank %}
          <h2 class="promo-banner__title">{{ block.settings.title | escape }}</h2>
        {% endif %}
        {% if block.settings.button_label != blank %}
          <span class="promo-banner__button">{{ block.settings.button_label | escape }}</span>
        {% endif %}
      </div>
    </a>
  {% endfor %}
</div>

{% stylesheet %}
  .promo-banners {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: start;
  }

  .promo-banners--full {
    gap: 0;
  }

  .promo-banners--page {
    gap: 0.5rem;
  }

  .promo-banner {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: var(--banner-ratio, 16 / 9);
    overflow: hidden;
    color: #fff;
    text-decoration: none;
  }

  .promo-banner__image,
  .promo-banner__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }

  .promo-banner__placeholder {
    background:
      linear-gradient(135deg, rgba(17, 17, 17, 0.35), rgba(17, 17, 17, 0.55)),
      linear-gradient(120deg, #3a3a3a, #1a1a1a);
  }

  .promo-banner::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.2) 0%,
      rgba(0, 0, 0, 0.15) 45%,
      rgba(0, 0, 0, 0.4) 100%
    );
  }

  .promo-banner__content {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    gap: 0.75rem;
    padding: clamp(1rem, 2.2vw, 1.5rem);
  }

  .promo-banner__title {
    margin: 0;
    font-size: clamp(0.95rem, 1.5vw, 1.15rem);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .promo-banner__button {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    justify-content: center;
    min-height: 2.15rem;
    padding: 0.55rem 1.1rem;
    background: #111;
    color: #fff;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: transform 0.25s ease, background-color 0.25s ease;
  }

  .promo-banner:hover .promo-banner__button {
    background: #000;
    transform: translateY(-2px);
  }

  .promo-banner__image {
    transition: transform 0.6s ease;
  }

  .promo-banner:hover .promo-banner__image {
    transform: scale(1.04);
  }

  @media screen and (max-width: 749px) {
    .promo-banners {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.promo_banners",
  "max_blocks": 2,
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:labels.section_width",
      "options": [
        {
          "value": "page",
          "label": "t:options.section_width.page"
        },
        {
          "value": "full",
          "label": "t:options.section_width.full"
        }
      ],
      "default": "page"
    },
    {
      "type": "header",
      "content": "t:labels.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.padding_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.padding_bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "t:general.banner",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:labels.title",
          "default": "Car care"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "t:labels.button_label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:labels.link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.promo_banners",
      "settings": {
        "section_width": "page"
      },
      "blocks": [
        {
          "type": "banner",
          "settings": {
            "title": "Car care",
            "button_label": "Shop now"
          }
        },
        {
          "type": "banner",
          "settings": {
            "title": "Maintenance",
            "button_label": "Shop now"
          }
        }
      ]
    }
  ]
}
{% endschema %}
