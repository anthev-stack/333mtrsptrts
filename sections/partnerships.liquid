    },
    {
      "type": "url",
      "id": "featured_url",
      "label": "t:labels.partnerships_site_url",
      "info": "t:labels.partnerships_site_url_info"
    },
    {
      "type": "text",
      "id": "featured_button_label",
      "label": "t:labels.button_label",
      "info": "t:labels.partnerships_button_info"
    },
    {
      "type": "header",
      "content": "t:labels.partnerships_links"
    },
    {
      "type": "url",
      "id": "featured_instagram",
      "label": "t:labels.instagram_url"
    },
    {
      "type": "url",
      "id": "featured_youtube",
      "label": "t:labels.youtube_url"
    },
    {
      "type": "url",
      "id": "featured_tiktok",
      "label": "t:labels.tiktok_url"
    },
    {
      "type": "url",
      "id": "featured_facebook",
      "label": "t:labels.facebook_url"
    },
    {
      "type": "url",
      "id": "featured_x_url",
      "label": "t:labels.x_url"
    },
    {
      "type": "url",
      "id": "featured_extra_url",
      "label": "t:labels.partnerships_extra_url"
    },
    {
      "type": "text",
      "id": "featured_extra_label",
      "label": "t:labels.partnerships_extra_label",
      "info": "t:labels.partnerships_extra_label_info"
    },
    {
      "type": "header",
      "content": "t:labels.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.padding_bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "partner",
