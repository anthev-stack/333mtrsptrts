{% comment %}
  Current partners — featured main partner, then a 2-column grid. Edited in Shopify.
  Distinct from the Partnership inquiry page (become a partner).
{% endcomment %}

{% liquid
  assign featured_name = section.settings.featured_name | strip
  assign featured_blurb_plain = section.settings.featured_blurb | strip_html | strip
  assign show_featured = false
  if section.settings.featured_logo != blank or section.settings.featured_profile != blank or featured_name != blank or featured_blurb_plain != blank or section.settings.featured_url != blank or section.settings.featured_instagram != blank or section.settings.featured_youtube != blank or section.settings.featured_tiktok != blank or section.settings.featured_facebook != blank or section.settings.featured_x_url != blank or section.settings.featured_extra_url != blank
    assign show_featured = true
  endif
%}

{% render 'section-padding' %}

<section class="membership partnerships" data-partnerships-page>
  <div class="membership__inner partnerships__inner">
    <p class="membership__eyebrow">
      {% if section.settings.eyebrow != blank %}
        {{ section.settings.eyebrow | escape }}
      {% else %}
        {{ 'partnerships.eyebrow' | t }}
      {% endif %}
    </p>
    <h1 class="membership__title">
      {% if section.settings.title != blank %}
        {{ section.settings.title | escape }}
      {% else %}
        {{ 'partnerships.title' | t }}
      {% endif %}
    </h1>

    {% if section.settings.show_intro %}
      {% assign intro_plain = section.settings.intro | strip_html | strip %}
      {% if intro_plain != blank %}
        <div class="membership__panel partnerships__intro">
          <div class="membership__benefits">{{ section.settings.intro }}</div>
        </div>
      {% else %}
        <div class="membership__panel partnerships__intro">
          <p class="membership__benefits">{{ 'partnerships.intro' | t }}</p>
        </div>
      {% endif %}
    {% endif %}

    {% if show_featured %}
      <article class="membership__panel partnerships__featured">
        <p class="partnerships__kicker">{{ 'partnerships.featured_label' | t }}</p>
        <div class="partnerships__featured-row">
          {% if section.settings.featured_logo != blank %}
            {% assign featured_alt = featured_name | default: shop.name %}
            <div class="partnerships__logo partnerships__logo--featured">
              {{
                section.settings.featured_logo
                | image_url: width: 800
                | image_tag:
                  loading: 'lazy',
                  widths: '200, 400, 600, 800',
                  sizes: '(min-width: 750px) 16rem, 70vw',
                  alt: featured_alt
              }}
            </div>
          {% endif %}
          <div class="partnerships__copy">
            {% if featured_name != blank %}
              <h2 class="partnerships__name partnerships__name--featured">{{ featured_name | escape }}</h2>
            {% endif %}
            <div class="partnerships__textwrap{% if section.settings.featured_profile != blank %} partnerships__textwrap--profile{% endif %}">
              {% if section.settings.featured_profile != blank %}
                {% assign featured_profile_alt = featured_name | default: shop.name %}
                <div class="partnerships__profile" style="float: right; width: 104px; height: 104px; margin: 1.6em 0 0 12px;">
                  {{
                    section.settings.featured_profile
                    | image_url: width: 320
                    | image_tag:
                      loading: 'lazy',
                      class: 'partnerships__profile-img',
                      widths: '160, 240, 320',
                      sizes: '104px',
                      alt: featured_profile_alt
                  }}
                </div>
              {% endif %}
              {% if featured_blurb_plain != blank %}
                <div class="membership__benefits">{{ section.settings.featured_blurb }}</div>
              {% endif %}
              {% render 'partnerships-links',
                website: section.settings.featured_url,
                website_label: section.settings.featured_button_label,
                instagram: section.settings.featured_instagram,
                youtube: section.settings.featured_youtube,
                tiktok: section.settings.featured_tiktok,
                facebook: section.settings.featured_facebook,
                x: section.settings.featured_x_url,
                extra: section.settings.featured_extra_url,
                extra_label: section.settings.featured_extra_label
              %}
            </div>
          </div>
        </div>
      </article>
    {% endif %}

    <div class="partnerships__grid">
      {% for block in section.blocks %}
        {% liquid
          assign pname = block.settings.name | strip
          assign pblurb = block.settings.blurb | strip_html | strip
        %}
        {% if block.settings.logo != blank or block.settings.profile_image != blank or pname != blank or pblurb != blank or block.settings.url != blank or block.settings.instagram != blank or block.settings.youtube != blank or block.settings.tiktok != blank or block.settings.facebook != blank or block.settings.x_url != blank or block.settings.extra_url != blank %}
          <article class="membership__panel partnerships__card" {{ block.shopify_attributes }}>
            {% if block.settings.logo != blank %}
              {% assign partner_alt = pname | default: shop.name %}
              <div class="partnerships__logo">
                {{
                  block.settings.logo
                  | image_url: width: 600
                  | image_tag:
                    loading: 'lazy',
                    widths: '160, 320, 480, 600',
                    sizes: '(min-width: 750px) 14rem, 70vw',
                    alt: partner_alt
                }}
              </div>
            {% endif %}
            {% if pname != blank %}
              <h2 class="partnerships__name">{{ pname | escape }}</h2>
            {% endif %}
            <div class="partnerships__textwrap{% if block.settings.profile_image != blank %} partnerships__textwrap--profile{% endif %}">
              {% if block.settings.profile_image != blank %}
                {% assign profile_alt = pname | default: shop.name %}
                <div class="partnerships__profile" style="float: right; width: 104px; height: 104px; margin: 1.6em 0 0 12px;">
                  {{
                    block.settings.profile_image
                    | image_url: width: 320
                    | image_tag:
                      loading: 'lazy',
                      class: 'partnerships__profile-img',
                      widths: '160, 240, 320',
                      sizes: '104px',
                      alt: profile_alt
                  }}
                </div>
              {% endif %}
              {% if pblurb != blank %}
                <div class="membership__benefits">{{ block.settings.blurb }}</div>
              {% endif %}
              {% render 'partnerships-links',
                website: block.settings.url,
                website_label: block.settings.button_label,
                instagram: block.settings.instagram,
                youtube: block.settings.youtube,
                tiktok: block.settings.tiktok,
                facebook: block.settings.facebook,
                x: block.settings.x_url,
                extra: block.settings.extra_url,
                extra_label: block.settings.extra_label
              %}
            </div>
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .partnerships__inner {
    max-width: 52rem;
  }

  .partnerships__intro {
    margin-bottom: 1rem;
  }

  .partnerships__kicker {
    margin: 0 0 0.85rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #666;
  }

  .partnerships__featured {
    margin-bottom: 1rem;
  }

  .partnerships__featured-row {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .partnerships__logo {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    min-height: 4.5rem;
  }

  .partnerships__logo img {
    display: block;
    width: auto;
    max-width: 100%;
    max-height: 4.5rem;
    height: auto;
    object-fit: contain;
  }

  .partnerships__logo--featured img {
    max-height: 7.5rem;
  }

  .partnerships__name {
    margin: 0 0 0.5rem;
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1.2;
  }

  .partnerships__name--featured {
    font-size: 1.25rem;
  }

  .partnerships .membership__benefits {
    margin-bottom: 0.85rem;
  }

  .partnerships .membership__actions {
    margin-top: 0.5rem;
    align-items: center;
  }

  .partnerships__textwrap {
    min-width: 0;
  }

  .partnerships__textwrap--profile {
    position: relative;
    display: block;
    overflow: hidden;
    min-height: calc(1.6em + 104px);
  }

  .partnerships__textwrap--profile .partnerships__profile {
    float: right;
    width: 104px;
    height: 104px;
    margin: 1.6em 0 0 12px;
  }

  .partnerships__textwrap--profile .membership__benefits {
    display: block;
    margin-bottom: 0;
    padding-bottom: 28px;
    overflow: visible;
  }

  .partnerships__textwrap--profile .partnerships__actions {
    position: absolute;
    left: 0;
    bottom: 0;
    right: 116px;
    margin-top: 0;
  }

  .partnerships__profile-img,
  .partnerships__profile img {
    display: block;
    width: 104px;
    height: 104px;
    max-width: 104px;
    object-fit: cover;
  }

  .partnerships__icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #111;
    background: transparent;
    text-decoration: none;
  }

  .partnerships__icon-link .partnerships-icon {
    display: block;
    width: 1.15rem;
    height: 1.15rem;
    fill: currentColor;
  }

  .partnerships__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .partnerships__card {
    display: block;
  }

  @media screen and (min-width: 750px) {
    .partnerships__featured-row {
      flex-direction: row;
      align-items: flex-start;
      gap: 1.5rem;
    }

    .partnerships__logo--featured {
      flex: 0 0 16rem;
      min-height: 7.5rem;
    }

    .partnerships__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.partnerships",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
